# ---------- Claude (генерация постов) ----------
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5

# ---------- Telegram (модерация: кнопка "в Threads") ----------
TELEGRAM_TOKEN=123456:ABC...
# Чат, куда бот шлёт посты на утверждение (свой user id или id группы)
TELEGRAM_CHAT_ID=123456789

# ---------- Threads ----------
# Долгоживущий токен (60 дней). Скоупы: threads_basic, threads_content_publish
# и, если есть, threads_keyword_search
THREADS_ACCESS_TOKEN=THAA...
# Числовой id аккаунта; "me" тоже работает
THREADS_USER_ID=me

# ---------- Поведение ----------
# 0 = ждать кнопку в Telegram (по умолчанию), 1 = публиковать сразу
AUTO_PUBLISH=0
# Как часто запускать пайплайн
POST_INTERVAL_HOURS=8
# Сколько вариантов генерировать за прогон
POSTS_PER_RUN=3
# Не публиковать, если в суточной квоте Threads осталось меньше
MIN_QUOTA_LEFT=5
